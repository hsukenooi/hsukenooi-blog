---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
  class?: string;
}

const { href, external, underline = true, class: className, ...rest } = Astro.props;
---

<a
  href={href}
  target={ external ? "_blank" : "_self" }
  class={cn("inline-block decoration-link hover:decoration-link-hover text-current hover:text-strong transition-colors duration-300 ease-in-out", underline && "underline [text-underline-position:from-font] [text-decoration-skip-ink:auto]", className)}
  {...rest}>
  <slot/>
</a>
