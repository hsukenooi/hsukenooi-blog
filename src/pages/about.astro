---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
---

<PageLayout title="About" description="Hsu Ken Ooi is Co-Founder and Managing Partner at Iterative, a startup accelerator focused exclusively on Southeast Asia.">
  <Container>
    <div class="space-y-10">
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        About
      </div>
      <article class="animate space-y-4">
        <p>
          Hsu Ken Ooi is Co-Founder and Managing Partner at <Link href="https://iterative.vc" external>Iterative</Link>, a startup accelerator focused exclusively on Southeast Asia.
        </p>
        <p>
          In 2018, he was Chief Product Officer of Workmate (acquired by Persol), an on-demand blue collar staffing platform in Southeast Asia. In 2014, he was VP of Product at Weave (YCS14 and acquired by LunchClub). In 2009, he was Co-Founder of Decide.com (acquired by eBay) an early machine learning company that predicted the future price of consumer goods.
        </p>
        <p>
          Hsu Ken has a Bachelors of Science in Mathematics and Statistics from the University of Washington and is originally from Penang, Malaysia.
        </p>
      </article>
    </div>
  </Container>
</PageLayout>
