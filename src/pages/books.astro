<PageLayout title="Books" description="Books I've read, with recommendations highlighted.">
  <Container>
    <div class="space-y-10">
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        Books
      </div>
      <p class="animate text-sm">
        People often ask for book recommendations and I like seeing what other people are reading so here is a list of books I own. I've probably read 70% of them. I wouldn't recommend all of them but those I liked are in <em>italics</em> and those I'd recommend are in <em>italics</em> and <strong>bold</strong>.
      </p>
      <div class="space-y-10">
        {books.map(({ year, items }) => (
          <section class="animate space-y-3">
            <div class="font-semibold text-black dark:text-white">
              {year}
            </div>
            <ul class="flex flex-col">
              {items.map((book) => (
                <li class="border-b border-black/10 dark:border-white/10 last:border-none">
                  <a href={book.href} target="_blank" rel="noopener noreferrer" class="group flex items-baseline justify-between gap-4 py-2.5 hover:text-black dark:hover:text-white transition-colors duration-200">
                    <span class="text-sm font-medium">
                      {book.favorite ? <strong><em>{book.title}</em></strong> : book.recommended ? <em>{book.title}</em> : book.title}
                    </span>
                    <span class="text-xs opacity-40 whitespace-nowrap shrink-0">{book.author}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </Container>
</PageLayout>
