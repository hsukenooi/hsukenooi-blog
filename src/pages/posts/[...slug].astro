---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { SITE, SOCIALS } from "@consts";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await post.render();

// BUI-688: per-post BlogPosting structured data.
const postURL = new URL(`/posts/${post.slug}`, Astro.site).toString();
const ogImageURL = new URL(`/posts/og/${post.slug}.png`, Astro.site).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  url: postURL,
  image: ogImageURL,
  author: {
    "@type": "Person",
    name: SITE.NAME,
    url: "https://hsukenooi.com",
    sameAs: SOCIALS.map((social) => social.HREF),
  },
};
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  image={`/posts/og/${post.slug}.png`}
  pubDate={post.data.pubDate}
  slug={post.slug}
  jsonLd={jsonLd}
>
  <Container>
    <div class="space-y-2 my-10">
      <h1 class="animate text-2xl font-semibold text-black dark:text-white">
        {post.data.title}
      </h1>
      <div class="animate text-sm text-black/55 dark:text-white/50">
        <FormattedDate date={post.data.pubDate} />
      </div>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>