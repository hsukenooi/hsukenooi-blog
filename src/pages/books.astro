---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { books, type Book } from "@data/books";
import coversRaw from "@data/covers.json";

const covers = coversRaw as Record<string, string | null>;

function getCover(book: Book): string | null {
  if (book.coverUrl) return book.coverUrl;
  return covers[book.title] ?? null;
}
---

<PageLayout title="Books" description="Books I've read, with recommendations highlighted.">
  <Container>
    <div class="animate space-y-1 mb-10">
      <div class="text-2xl font-semibold text-black dark:text-white">Books</div>
      <p class="text-sm opacity-50">★ = recommended</p>
    </div>
  </Container>
  <div class="mx-auto max-w-screen-lg px-5 space-y-12">
    {books.map(({ year, items }) => (
      <section class="animate space-y-4">
        <div class="font-semibold text-black dark:text-white">{year}</div>
        <div class="grid grid-cols-4 gap-6">
          {items.map((book) => {
            const cover = getCover(book);
            return (
              <a href={book.href} target="_blank" rel="noopener noreferrer" class="group flex flex-col gap-2.5">
                <div class="relative aspect-[2/3] w-full overflow-hidden rounded-lg bg-black/5 dark:bg-white/5">
                  {cover ? (
                    <img
                      src={cover}
                      alt={book.title}
                      class="w-full h-full object-cover transition-opacity duration-200 group-hover:opacity-80"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center p-3">
                      <span class="text-[11px] text-center leading-snug opacity-40 line-clamp-6">{book.title}</span>
                    </div>
                  )}
                  {(book.recommended || book.favorite) && (
                    <span class="absolute top-2 right-2 w-6 h-6 flex items-center justify-center rounded-full bg-black/40 text-white/90 text-xs backdrop-blur-sm">★</span>
                  )}
                </div>
                <div class="space-y-0.5">
                  <div class="text-[15px] font-normal tracking-[0.0025em] leading-snug text-black dark:text-white line-clamp-2">{book.title}</div>
                  <div class="text-xs opacity-50 leading-snug truncate">{book.author}</div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</PageLayout>
