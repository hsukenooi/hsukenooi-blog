# Resend API key (Full access) — used by both the Vercel signup function and local send/import scripts
RESEND_API_KEY=re_...

# Resend Topic ID — created via "resend topics create"; new signups are opted in to this topic,
# and broadcasts associate with it so the unsubscribe link scopes to this newsletter only.
RESEND_TOPIC_ID=...

# Resend Segment ID — created via "resend segments create"; broadcasts target this segment.
# New signups are added to the segment alongside the topic opt-in. Contacts are global (no audienceId).
RESEND_SEGMENT_ID=...

# From address and display name for all newsletter sends (e.g., "Hsu Ken Ooi <hello@hsukenooi.com>")
NEWSLETTER_FROM=...

# Cloudflare Turnstile secret key — used server-side in the signup function to verify challenge tokens
TURNSTILE_SECRET_KEY=...

# Cloudflare Turnstile site key — exposed client-side in the signup form widget (PUBLIC_ prefix is required by Astro)
PUBLIC_TURNSTILE_SITE_KEY=...
