# Resend API key (Full access) — used by both the Vercel signup function and local send/import scripts
RESEND_API_KEY=re_...

# Resend Audience ID — created in the Resend dashboard; all subscribers are in this single audience
RESEND_AUDIENCE_ID=...

# From address and display name for all newsletter sends (e.g., "Hsu Ken Ooi <hello@hsukenooi.com>")
NEWSLETTER_FROM=...

# Cloudflare Turnstile secret key — used server-side in the signup function to verify challenge tokens
TURNSTILE_SECRET_KEY=...

# Cloudflare Turnstile site key — exposed client-side in the signup form widget (PUBLIC_ prefix is required by Astro)
PUBLIC_TURNSTILE_SITE_KEY=...
