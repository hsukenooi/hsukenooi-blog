---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

type Props = {
  title: string;
  description: string;
  pubDate?: Date;
  noindex?: boolean;
};

const { title, description, pubDate, noindex } = Astro.props;

// Pages that already carry the site identity in their title (e.g. the
// homepage) shouldn't get "| Hsu Ken Ooi" appended a second time.
const pageTitle =
  title === SITE.NAME || title.startsWith(SITE.NAME)
    ? title
    : `${title} | ${SITE.NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={pageTitle}
      description={description}
      pubDate={pubDate}
      noindex={noindex}
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Analytics />
    <SpeedInsights />
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    ></script>
  </body>
</html>
