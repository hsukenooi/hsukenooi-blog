# Scope Vercel CLI to the hsukenooi@gmail.com account for this repo.
#
# The `vercel` CLI authenticates globally in ~/.local/share/com.vercel.cli/auth.json,
# so juggling personal and Iterative accounts means logging in and out. Setting
# VERCEL_TOKEN here makes `vercel ...` inside this repo always use the personal
# account, regardless of who is interactively logged in.
#
# Setup:
#   1. Generate a token at https://vercel.com/account/tokens while signed in as
#      hsukenooi@gmail.com (scope: hsukenoois-projects).
#   2. Save it to ~/.config/vercel/personal-token (chmod 600).
#   3. `direnv allow` in this directory.
#
# The token file lives outside the repo; this .envrc carries no secret.

token_file="$HOME/.config/vercel/personal-token"

if [[ -f "$token_file" ]]; then
  export VERCEL_TOKEN="$(tr -d '[:space:]' < "$token_file")"
  watch_file "$token_file"
else
  log_status "VERCEL_TOKEN not set — create $token_file (see .envrc for instructions)"
fi
