---
import { NEWSLETTER } from "@consts/newsletter";

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<div id="signup-wrapper">
  <form id="signup-form" novalidate>
    <!-- honeypot: hidden from sighted users and screen readers -->
    <div
      aria-hidden="true"
      style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;"
    >
      <input
        type="text"
        name="company"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <!-- Turnstile invisible widget -->
    <div
      id="cf-turnstile-widget"
      class="cf-turnstile"
      data-sitekey={siteKey}
      data-action="newsletter-subscribe"
      data-size="invisible"
      data-execution="execute"
      data-callback="onTurnstileSuccess"
      data-error-callback="onTurnstileError"
      data-expired-callback="onTurnstileExpired"
      data-timeout-callback="onTurnstileTimeout"
    ></div>

    <p class="font-serif text-sm font-semibold mb-1">{NEWSLETTER.SECTION_HEADING}</p>
    <p class="text-sm mb-2 text-muted text-pretty">{NEWSLETTER.PROMISE}</p>
    <div class="flex gap-2">
      <label for="email-input" class="sr-only">Email address</label>
      <input
        type="email"
        id="email-input"
        name="email"
        placeholder={NEWSLETTER.PLACEHOLDER}
        inputmode="email"
        autocomplete="email"
        class="flex-1 min-w-0 px-3 py-2 text-sm border border-control rounded bg-transparent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-focus"
      />
      <button
        id="signup-submit"
        type="submit"
        class="px-4 py-2 text-sm border border-control rounded hover:bg-surface-hover transition-colors duration-200 whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed"
      >
        {NEWSLETTER.BUTTON_SUBSCRIBE}
      </button>
    </div>
    <p
      id="signup-error"
      class="hidden text-xs mt-1 text-danger"
      role="alert"
    ></p>
    <p class="text-xs mt-2 text-muted">{NEWSLETTER.PRIVACY_DISCLOSURE}</p>
  </form>

  <div
    id="signup-success"
    class="hidden text-sm"
    role="status"
    aria-live="polite"
  >
    {NEWSLETTER.SUCCESS_MESSAGE}
  </div>
</div>

<script>
  import { NEWSLETTER } from "@consts/newsletter";

  interface Turnstile {
    execute(container: string): void;
    reset(container: string): void;
  }
  const w = window as Window & {
    turnstile?: Turnstile;
    onTurnstileSuccess?: unknown;
    onTurnstileError?: unknown;
    onTurnstileExpired?: unknown;
    onTurnstileTimeout?: unknown;
  };

  // Belt-and-suspenders watchdog: if Turnstile fires no callback within this
  // window, surface a retryable error instead of leaving the button stuck.
  const TURNSTILE_WATCHDOG_MS = 15000;

  const form = document.getElementById("signup-form") as HTMLFormElement;
  const emailInput = document.getElementById("email-input") as HTMLInputElement;
  const submitBtn = document.getElementById("signup-submit") as HTMLButtonElement;
  const errorEl = document.getElementById("signup-error")!;
  const successEl = document.getElementById("signup-success")!;

  let pendingEmail: string | null = null;
  let watchdogTimer: ReturnType<typeof setTimeout> | null = null;

  function clearWatchdog() {
    if (watchdogTimer !== null) {
      clearTimeout(watchdogTimer);
      watchdogTimer = null;
    }
  }

  function showError(msg: string) {
    clearWatchdog();
    errorEl.textContent = msg;
    errorEl.classList.remove("hidden");
    emailInput.setAttribute("aria-invalid", "true");
    emailInput.setAttribute("aria-describedby", "signup-error");
    emailInput.focus();
    submitBtn.disabled = false;
    submitBtn.textContent = NEWSLETTER.BUTTON_SUBSCRIBE;
    pendingEmail = null;
    // Reset Turnstile so the next submit can re-execute
    if (w.turnstile) w.turnstile.reset("#cf-turnstile-widget");
  }

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    submitBtn.textContent = loading
      ? NEWSLETTER.BUTTON_SUBSCRIBING
      : NEWSLETTER.BUTTON_SUBSCRIBE;
  }

  function showSuccess() {
    form.classList.add("hidden");
    successEl.classList.remove("hidden");
    successEl.focus();
  }

  // Fire-and-forget report so we can observe client-side Turnstile failures in
  // Vercel logs. Vercel never sees these otherwise — by definition they never
  // reach /api/subscribe.
  function reportClientError(reason: string) {
    fetch("/api/client-error", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ reason }),
      keepalive: true,
    }).catch(() => {});
  }

  // Called by Turnstile when the invisible challenge resolves
  w.onTurnstileSuccess = async function (token: string) {
    clearWatchdog();
    if (!pendingEmail) return;
    const email = pendingEmail;
    pendingEmail = null;

    try {
      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email,
          "cf-turnstile-response": token,
        }),
      });

      if (!res.ok) {
        showError(NEWSLETTER.ERROR_SERVER);
        return;
      }

      showSuccess();
    } catch {
      showError(NEWSLETTER.ERROR_SERVER);
    }
  };

  w.onTurnstileError = function () {
    reportClientError("turnstile_error");
    showError(NEWSLETTER.ERROR_TRY_AGAIN);
  };

  w.onTurnstileExpired = function () {
    reportClientError("turnstile_expired");
    showError(NEWSLETTER.ERROR_TRY_AGAIN);
  };

  w.onTurnstileTimeout = function () {
    reportClientError("turnstile_timeout");
    showError(NEWSLETTER.ERROR_TRY_AGAIN);
  };

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    errorEl.classList.add("hidden");
    emailInput.removeAttribute("aria-invalid");
    emailInput.removeAttribute("aria-describedby");

    const email = emailInput.value.trim();

    // Client-side email validation
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showError(NEWSLETTER.ERROR_INVALID_EMAIL);
      return;
    }

    pendingEmail = email;
    setLoading(true);

    if (w.turnstile) {
      try {
        w.turnstile.execute("#cf-turnstile-widget");
        // Guard against any failure mode where Turnstile fires no callback.
        clearWatchdog();
        watchdogTimer = setTimeout(() => {
          reportClientError("turnstile_watchdog");
          showError(NEWSLETTER.ERROR_TRY_AGAIN);
        }, TURNSTILE_WATCHDOG_MS);
      } catch {
        showError(NEWSLETTER.ERROR_SERVER);
      }
    } else {
      // Turnstile not loaded — treat as server error
      showError(NEWSLETTER.ERROR_SERVER);
    }
  });
</script>
