---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import Link from "@components/Link.astro";
import { HOME, SITE, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// BUI-688: homepage Person + WebSite structured data.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: SITE.NAME,
    jobTitle: "Co-Founder & Managing Partner",
    worksFor: {
      "@type": "Organization",
      name: "Iterative",
      url: "https://iterative.vc",
    },
    url: "https://hsukenooi.com",
    sameAs: SOCIALS.map((social) => social.HREF),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.NAME,
    url: "https://hsukenooi.com",
  },
];
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION} jsonLd={jsonLd}>
  <Container>
    <h4 class="animate font-semibold text-strong">
      Hi, I'm Hsu Ken <span class="text-xl">👋🏻</span>
    </h4>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate">
            I'm Co-Founder and Managing Partner at <Link href="https://iterative.vc" aria-label="Iterative" external>Iterative</Link>, a startup accelerator focused exclusively on Southeast Asia.
          </p>
          <p class="animate">
            Before Iterative, I started 2 companies Weave (YCS14, acquired by LunchClub) and Decide (<Link href="https://www.geekwire.com/2013/ebay-acquires-decidecom-shopping-research-site-shut-sept-30" external>acquired by eBay</Link>). I studied mathematics in school, played video games for money and I'm originally from Penang, Malaysia.
          </p>
          <p class="animate">
            I typically write about startups but will occasionally write about other things. You should subscribe.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-strong">
            Writing
          </h5>
        </div>
        <ul class="flex flex-col">
          {blog.map(post => (
            <li class="border-b border-divider last:border-none">
              <a href={`/posts/${post.slug}`} class="group flex items-baseline justify-between gap-4 py-3 hover:text-strong">
                <span class="text-[15px] font-normal tracking-[0.0025em] leading-[1.4] text-balance">{post.data.title}</span>
                <span class="text-xs text-muted whitespace-nowrap shrink-0 tabular-nums tracking-[0.02em]">
                  {post.data.pubDate.toLocaleDateString("en-US", { month: "short", year: "numeric" })}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
