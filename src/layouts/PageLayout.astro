---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

type JsonLdData = Record<string, unknown>;

type Props = {
  title: string;
  description: string;
  image?: string;
  pubDate?: Date;
  noindex?: boolean;
  slug?: string;
  jsonLd?: JsonLdData | JsonLdData[];
};

const { title, description, image, pubDate, noindex, slug, jsonLd } = Astro.props;

// Pages that already carry the site identity in their title (e.g. the
// homepage) shouldn't get "| Hsu Ken Ooi" appended a second time.
const pageTitle =
  title === SITE.NAME || title.startsWith(SITE.NAME)
    ? title
    : `${title} | ${SITE.NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={pageTitle}
      description={description}
      image={image}
      pubDate={pubDate}
      noindex={noindex}
      slug={slug}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-strong focus:outline focus:outline-2 focus:outline-focus"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Analytics />
    <SpeedInsights />
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    ></script>
  </body>
</html>
